# Copy this file to ".env" in the same folder as sync-jira-to-multica.mjs and fill in the values.
# Never commit ".env". It contains secrets.
# Run the script from this folder: it reads ".env" from the current directory.

# --- Jira (read only) ---
# Your Jira Cloud site, without a trailing slash.
JIRA_BASE_URL=https://your-site.atlassian.net
# Email of the Atlassian account that owns the API token.
JIRA_EMAIL=<your-atlassian-email>
# Atlassian API token (Atlassian account -> Security -> API tokens).
# Use an account with read-only access if you can.
JIRA_API_TOKEN=<your-atlassian-api-token>
# Key of the Jira project to sync, for example ABC.
# Not needed when JIRA_JQL is set or when you run with --issue.
JIRA_PROJECT_KEY=<your-project-key>

# --- Multica ---
# API base URL. Multica Cloud uses https://api.multica.ai.
# For a self-hosted instance, use your own public API address.
MULTICA_API_URL=https://api.multica.ai
# Personal access token that starts with "mul_" (Multica -> Settings -> API Token).
# It can access every workspace of your account.
MULTICA_TOKEN=<mul_your-personal-access-token>
# Workspace slug: the <slug> in the workspace URL multica.ai/<slug>.
MULTICA_WORKSPACE_SLUG=<your-workspace-slug>

MULTICA_WORKSPACE_ID=

# --- Optional ---
# Custom JQL. It replaces JIRA_PROJECT_KEY.
# Default: project = "<JIRA_PROJECT_KEY>" ORDER BY created ASC
# JIRA_JQL=project = "ABC" AND updated >= -1d ORDER BY created ASC
# Map Jira status names to Multica status keys (JSON on one line).
# Without this, the Jira status category is used: new -> todo, indeterminate -> in_progress, done -> done.
# STATUS_MAP={"In Review":"in_review","Won't Do":"cancelled"}
# Where to keep the mapping between Jira keys and Multica ids.
# Default: ~/.multica-sync/state-<workspace slug or id>.json
# MULTICA_SYNC_STATE=
